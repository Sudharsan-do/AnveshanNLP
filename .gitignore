# Ignore everything by default (keeps venv, 1GB+ weights, test/submission files, caches, and scratch scripts out of GitHub)
*

# Git configuration & documentation
!.gitignore
!README.md

# Training notebooks (strictly train & CV only)
!aavesham_v2.ipynb
!nlu_pipeline.ipynb

# Training dataset & domain lexicons
!train.csv
!data/
!data/train.csv
!data/verified_class_meanings.json
!data/xlit_word_dict.json

# 5-fold CV metrics on train.csv
!benchmark_models_comparison.csv
!cv_metrics_comparison.csv

# Interactive Demo UI (excludes demo_ui/cache/ and __pycache__/)
!demo_ui/
!demo_ui/README.md
!demo_ui/server.py
!demo_ui/inference_engine.py
!demo_ui/static/
!demo_ui/static/**

# Never track OS/Python artifacts even inside un-ignored folders
.DS_Store
**/.DS_Store
**/__pycache__/
*.pyc
